# Beach Road Pizza storefront. Every NEXT_PUBLIC_ value is compiled into the
# public JavaScript, so nothing secret belongs here, and changing one needs a
# rebuild. Copy to .env.local for local development.

# The venue's CentralPass backend, no trailing /api.
NEXT_PUBLIC_CENTRALPASS_API_URL=http://localhost:3000

# Stripe PUBLISHABLE key only (pk_test_… or pk_live_…), from the same Stripe
# account and mode as the backend's STRIPE_SECRET_KEY. Leave blank to offer
# pay-in-store only.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# This site's public origin, used for canonical URLs, the sitemap and
# structured data. Must match the backend's PUBLIC_SITE_URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Optional Google Ads measurement. Leave blank for no tracking at all; setting
# it also switches on the advertising paragraph in the privacy policy.
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=
